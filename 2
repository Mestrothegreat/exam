9. File Transfer using Socket Programming

This program sends a file from the client to the server. The server saves it as received.txt.

Program 1: FileServer.java
import java.net.*;
import java.io.*;

public class FileServer {
    public static void main(String[] args) throws Exception {
        ServerSocket ss = new ServerSocket(5002);
        System.out.println("Waiting for file...");

        Socket s = ss.accept();

        DataInputStream in = new DataInputStream(
            s.getInputStream());

        FileOutputStream file =
            new FileOutputStream("received.txt");

        int size = in.readInt();
        byte[] data = new byte[4096];

        while (size > 0) {
            int len = in.read(data, 0,
                Math.min(data.length, size));

            if (len == -1)
                break;

            file.write(data, 0, len);
            size -= len;
        }

        file.close();
        s.close();
        ss.close();

        System.out.println("File received successfully");
    }
}
Program 2: FileClient.java
import java.net.*;
import java.io.*;
import java.util.Scanner;

public class FileClient {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter file path: ");
        String path = sc.nextLine();

        File file = new File(path);

        if (!file.isFile()) {
            System.out.println("File not found");
            return;
        }

        Socket s = new Socket("localhost", 5002);

        DataOutputStream out = new DataOutputStream(
            s.getOutputStream());

        FileInputStream in = new FileInputStream(file);

        out.writeInt((int) file.length());

        byte[] data = new byte[4096];
        int len;

        while ((len = in.read(data)) != -1)
            out.write(data, 0, len);

        out.flush();

        in.close();
        s.close();

        System.out.println("File sent successfully");
    }
}
