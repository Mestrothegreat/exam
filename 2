Enter source router: 0
Shortest distances:
Router 0 : 0
Router 1 : 2
Router 2 : 5
5. Error Detection using CRC

Program: Main.java

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter data bits: ");
        String data = sc.next();

        System.out.print("Enter generator bits: ");
        String gen = sc.next();

        int n = gen.length();
        String dividend = data + "0".repeat(n - 1);
        char[] bits = dividend.toCharArray();

        for (int i = 0; i < data.length(); i++) {
            if (bits[i] == '1') {
                for (int j = 0; j < n; j++) {
                    bits[i + j] =
                        bits[i + j] == gen.charAt(j) ? '0' : '1';
                }
            }
        }

        String remainder =
            new String(bits).substring(data.length());

        String codeword = data + remainder;

        System.out.println("CRC remainder: " + remainder);
        System.out.println("Transmitted codeword: " + codeword);

        System.out.print("Enter received codeword: ");
        String received = sc.next();

        char[] r = received.toCharArray();

        for (int i = 0; i <= received.length() - n; i++) {
            if (r[i] == '1') {
                for (int j = 0; j < n; j++) {
                    r[i + j] =
                        r[i + j] == gen.charAt(j) ? '0' : '1';
                }
            }
        }

        boolean error = false;

        for (char c : r)
            if (c != '0')
                error = true;

        if (error)
            System.out.println("Error detected");
        else
            System.out.println("No error detected");
    }
}

Sample output:

Enter data bits: 1101
Enter generator bits: 1011
CRC remainder: 001
Transmitted codeword: 1101001
Enter received codeword: 1101001
No error detected

To test error detection, enter 1100001 as the received codeword instead. The program should display Error detected.

