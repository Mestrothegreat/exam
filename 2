4. Link State Routing Algorithm — Dijkstra's Algorithm

Program: Main.java

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of routers: ");
        int n = sc.nextInt();

        int[][] cost = new int[n][n];
        int[] dist = new int[n];
        boolean[] visited = new boolean[n];

        System.out.println("Enter cost matrix (999 for no link):");
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                cost[i][j] = sc.nextInt();

        System.out.print("Enter source router: ");
        int src = sc.nextInt();

        for (int i = 0; i < n; i++)
            dist[i] = 999;

        dist[src] = 0;

        for (int count = 0; count < n; count++) {
            int u = -1;

            for (int i = 0; i < n; i++)
                if (!visited[i] &&
                    (u == -1 || dist[i] < dist[u]))
                    u = i;

            if (u == -1 || dist[u] == 999)
                break;

            visited[u] = true;

            for (int v = 0; v < n; v++) {
                if (!visited[v] && cost[u][v] != 999 &&
                    dist[u] + cost[u][v] < dist[v]) {
                    dist[v] = dist[u] + cost[u][v];
                }
            }
        }

        System.out.println("Shortest distances:");
        for (int i = 0; i < n; i++)
            System.out.println("Router " + i + " : " + dist[i]);
    }
}

