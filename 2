2. Congestion Control — Leaky Bucket Algorithm

Program: Main.java

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter bucket capacity: ");
        int capacity = sc.nextInt();

        System.out.print("Enter number of packets: ");
        int n = sc.nextInt();

        int water = 0;

        for (int i = 1; i <= n; i++) {
            System.out.print("Enter packet size: ");
            int packet = sc.nextInt();

            if (water + packet <= capacity) {
                water += packet;
                System.out.println("Packet accepted");
            } else {
                System.out.println("Packet dropped");
            }

            water = Math.max(0, water - 2);
            System.out.println("Remaining packets: " + water);
        }
    }
}

